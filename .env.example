# Copy this file to .env.local and fill in real values.
# These are public (NEXT_PUBLIC_*) because they only ever populate contact links —
# never commit real secrets here, only public profile URLs/addresses.

# Used to build a mailto: link on the Contact page and homepage contact section.
NEXT_PUBLIC_CONTACT_EMAIL=

# Full LinkedIn profile URL, e.g. https://www.linkedin.com/in/your-handle
NEXT_PUBLIC_LINKEDIN_URL=

# Full GitHub profile URL, e.g. https://github.com/your-handle
NEXT_PUBLIC_GITHUB_URL=
